# =============================================================================
# CULTURA TRANSPARENTE VIAMÃO - VARIÁVEIS DE AMBIENTE
# =============================================================================

# Chave de API para Dados do Portal da Transparência do Governo Federal (CGU)
# Necessária para consulta automatizada de Emendas Parlamentares Federais ao vivo.
# Obtenção gratuita: Acesse https://portaldatransparencia.gov.br/api-de-dados/cadastrar
# e cadastre seu e-mail para receber a chave 'chave-api-dados'.
# No Vercel: configure como variável de ambiente (Environment Variable) do projeto.
PORTAL_TRANSPARENCIA_API_KEY=

# Chave da API Google Gemini para o Assistente de IA de Projetos Culturais (Server-side)
GEMINI_API_KEY=

# OAuth 2.0 Client ID do Google Cloud para exportação direta ao Google Drive (Client-side, opcional)
# Se não configurado, o botão do Google Drive é ocultado e permanece o download em .docx.
VITE_GOOGLE_CLIENT_ID=
